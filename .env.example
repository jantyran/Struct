# セッション署名用の秘密鍵（必須: 長いランダム文字列を設定してください）
JWT_SECRET=change-this-to-a-long-random-string

# 外部公開 URL（招待リンクの生成に使用）
NEXT_PUBLIC_BASE_URL=http://localhost:3002

# サブパス配備時のみ設定（例: /struct）。ルート配備の場合は空のまま
NEXT_PUBLIC_BASE_PATH=

# true にすると誰でも /signup から登録可能。DB が空の場合（初回）は常に登録できます
ALLOW_PUBLIC_SIGNUP=false

# ── メール送信（パスワードリセット・ウェルカムメール）──────────────────
# 未設定の場合はメール送信が無効になります（パスワードリセット機能は管理者対応が必要）
# Gmail の場合: SMTP_HOST=smtp.gmail.com / SMTP_PORT=587 / アプリパスワードを使用
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 送信元表示名（省略時は SMTP_USER がそのまま使われます）
SMTP_FROM=Struct <noreply@example.com>
